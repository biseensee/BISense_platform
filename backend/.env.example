# ── App ──────────────────────────────────────────────────────────────────
APP_NAME="BI Platform"
APP_ENV=local                      # local | staging | production
DEBUG=true
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ── Security ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-a-64-byte-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (primary OLTP — metadata, users, dashboards) ─────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bi_platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bi_platform
# Set to a pgbouncer endpoint in production for connection pooling at scale
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ── Redis (cache, rate limiting, arq task queue) ───────────────────────────
REDIS_URL=redis://localhost:6379/0
QUERY_CACHE_TTL_SECONDS=300

# ── Object storage (exported reports, uploaded CSV datasources) ───────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bi-platform-artifacts

# ── Observability ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PATH=/metrics

# ── Data source encryption ─────────────────────────────────────────────
# Fernet key used to encrypt datasource connection secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATASOURCE_ENCRYPTION_KEY=change-me-fernet-key
